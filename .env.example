# ─────────────────────────────────────────────────────────────
# .env.example — copy to .env.common and service .env files
# DO NOT commit real secrets. This file is safe to commit.
# ─────────────────────────────────────────────────────────────

# ── .env.common ──────────────────────────────────────────────

APP_ENV=development
LOG_LEVEL=INFO

# JWT — must be identical across ALL services
JWT_SECRET=change-me-minimum-32-chars-long!!!!!
JWT_ALGORITHM=HS256
JWT_ISSUER=identity-service
JWT_AUDIENCE=cpa-services
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# Redis
REDIS_URL=redis://redis:6379
REDIS_DB=0
REDIS_PREFIX=cpa

# RabbitMQ
RABBITMQ_URL=amqp://rabbit:rabbitpassword@rabbitmq:5672/
RABBITMQ_EXCHANGE=cpa.events
RABBITMQ_PREFETCH=10

# HTTP
REQUEST_TIMEOUT=30
HTTP_POOL_SIZE=100

# ── identity-service ──────────────────────────────────────────

# APP_NAME=identity-service
# APP_VERSION=1.0.0
# APP_PORT=8000
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/identity_db
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10
# DATABASE_ECHO=false
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
# FRONTEND_ORIGIN=http://localhost

