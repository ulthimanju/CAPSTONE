# ==========================================
# SYNAPSE Root .gitignore
# Comprehensive rules for Python, Node, Docker,
# Environment Secrets, IDEs, and OS Files.
# ==========================================

# Environment & Secrets (Never commit credentials)
.env
.env.*
!.env.example
!.env.common.example

# Archives & Compressed Files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
services.zip

# Large Media & Video Binaries
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
env.bak/
venv.bak/
.python-version

# Python Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js & Web-App
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.eslintcache
.vite/
playwright-report/
test-results/

# Database & Persistent Storage Mounts
postgres_data/
pgvector_data/
mongo_data/
redis_data/
*.db
*.sqlite
*.sqlite3

# Temporary & Scratch Files
scratch/
test_documents/
tmp/
temp/
*.log
*.tmp
*.bak
*.swp
*.swo

# Agent & AI Tooling Directories
.agents/
**/.agents/

# IDE & Editor Settings (PyCharm, VSCode)
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
