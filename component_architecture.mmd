flowchart TD

    %% ── Client Layer ──
    subgraph CLIENT["Client Layer"]
        USER["Browser / Client"]
        WEB["web-app (React 18 + Vite)"]
        USER --> WEB
    end

    %% ── API Gateway Layer ──
    subgraph GATEWAY["Gateway & Ingress"]
        GW["api-gateway (FastAPI)"]
        WEB -->|HTTPS / REST| GW
    end

    %% ── Microservices Layer ──
    subgraph SERVICES["Microservices Layer"]
        ID["identity-service"]
        WS["workspace-service"]
        DOC["document-service"]
        RAG["rag-service"]
        AI["ai-service"]
        NOTIFY["notification-service"]
    end

    GW -->|/api/v1/auth, /sessions| ID
    GW -->|/api/v1/workspaces| WS
    GW -->|/api/v1/documents| DOC
    GW -->|/api/v1/rag| RAG
    GW -->|/api/v1/ai| AI
    GW -->|/api/v1/notifications| NOTIFY

    %% Service-to-Service Interaction
    RAG -->|1. Embedding & 2. LLM Synthesis| AI

    %% ── Message Broker & Cache ──
    subgraph MESSAGING["Event Bus & Cache"]
        RMQ[["RabbitMQ (Event Bus)"]]
        REDIS[("Redis (Rate Limits & Cache)")]
    end

    %% ── Data Storage Layer ──
    subgraph STORAGE["Databases & Vector Stores"]
        PG_ID[("PostgreSQL: identity_db")]
        PG_WS[("PostgreSQL: workspace_db")]
        PG_DOC[("PostgreSQL: document_db + pgvector")]
        MONGO[("MongoDB: notifications & audit")]
    end

    %% ── External Integrations ──
    subgraph EXTERNAL["External Cloud APIs"]
        GOOGLE["Google OAuth 2.0"]
        LLAMA["LlamaParse API"]
        GEMINI["Google Gemini API"]
    end

    %% Service Connections
    ID --> PG_ID
    ID --> REDIS
    ID --> GOOGLE

    WS --> PG_WS
    WS --> RMQ

    DOC --> PG_DOC
    DOC --> LLAMA
    DOC --> RMQ

    RAG --> PG_DOC
    RAG --> RMQ

    AI --> GEMINI
    AI --> RMQ

    RMQ -->|Consume Events| NOTIFY
    NOTIFY --> MONGO